# A prévia continua local, sem chamadas ao backend.
## use "mock" para simular chamadas ao backend, ou "api" para usar o backend real.
DELIVERY_DATA_SOURCE=mock

# Usada apenas pelo cliente no servidor com DELIVERY_DATA_SOURCE=api. Inclua /api.
DELIVERY_API_BASE_URL=https://seu-backend.example/api
DELIVERY_API_TIMEOUT_MS=10000