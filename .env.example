# A prévia continua local, sem chamadas ao backend.
## use "mock" para simular chamadas ao backend, ou "api" para usar o backend real.
DELIVERY_DATA_SOURCE=mock

# Usada apenas pelo cliente no servidor com DELIVERY_DATA_SOURCE=api. Inclua /api.
DELIVERY_API_BASE_URL=https://seu-backend.example/api
DELIVERY_API_TIMEOUT_MS=10000

# Analytics gratuito. ID público da propriedade GA4 (G-...). Sem ID, fica desativado.
NEXT_PUBLIC_GA4_ID=

# Envio da lista de lançamento. Chaves secretas ficam apenas no servidor.
RESEND_API_KEY=re_
RESEND_FROM_EMAIL=contato@binaryinc.com.br
RESEND_NOTIFICATION_EMAIL=contato@binaryinc.com.br

# Proteção gratuita contra bots. Crie um widget Turnstile com os hostnames do site.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
WAITLIST_ALLOWED_HOSTNAMES=papum.app.br,www.papum.app.br
